NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_SLOT_ID=

# Create a Supabase project, run supabase/migrations, and configure its Auth redirect URL.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only Supabase secret key. Never prefix with NEXT_PUBLIC_ or expose it in the browser.
SUPABASE_SECRET_KEY=

# Comma-separated email addresses allowed to open the server-protected /admin overview.
ADMIN_EMAILS=
